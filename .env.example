# Security Configuration
# Copy this file to .env and fill in with real values

# Flask Secret Key - MUST be set in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Flask Environment (development, staging, production)
FLASK_ENV=production

# Debug Mode (NEVER True in production)
FLASK_DEBUG=False

# Session Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Security Headers
ENABLE_HSTS=True
HSTS_MAX_AGE=31536000
ENABLE_CSP=True

# Rate Limiting
RATE_LIMIT_GENERAL=300
RATE_LIMIT_ADMIN=100
RATE_LIMIT_LOGIN=10

# File Upload Security
MAX_UPLOAD_SIZE=52428800
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Database Encryption
DB_ENCRYPTION_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_SENSITIVE_DATA=False

# Server Configuration
SERVER_PORT=443
SERVER_SSL_ENABLED=True
SERVER_SSL_CERT_PATH=/path/to/cert.pem
SERVER_SSL_KEY_PATH=/path/to/key.pem
